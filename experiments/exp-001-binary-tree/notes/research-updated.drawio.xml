<mxfile host="app.diagrams.net" pages="3">
  <diagram id="paired-overview" name="1 - Paired experiment">
    <mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="PAIRED EXPERIMENT — SAME TASK AND BUDGET" style="text;html=0;fontSize=23;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="25" width="880" height="45" as="geometry"/></mxCell>
        <mxCell id="config" value="HOST CONTROLLER&#xa;Freeze source, pseudocode, model, limits, rubric&#xa;No existing Lean solution supplied" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="410" height="100" as="geometry"/></mxCell>
        <mxCell id="stateless" value="1. STATELESS BUILDER&#xa;Fresh Docker container&#xa;Source + clean Lean project; no external memory" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;" vertex="1" parent="1"><mxGeometry x="90" y="285" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="retrieved" value="2. RETRIEVED BUILDER&#xa;Separate fresh Docker container&#xa;Same source + approved frozen memory" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="610" y="285" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="memory" value="FROZEN MEMORY&#xa;Read-only mount&#xa;No completed target proof" style="shape=cylinder3;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;size=15;" vertex="1" parent="1"><mxGeometry x="1030" y="285" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="loop-a" value="BOUNDED PASSES — SEE PAGE 2&#xa;Builder → offline verifier → separate critic&#xa;Own candidate and repair feedback only" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;" vertex="1" parent="1"><mxGeometry x="90" y="445" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="loop-b" value="SAME BOUNDED PASSES&#xa;Builder → offline verifier → separate critic&#xa;No access to condition 1 outputs" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="610" y="445" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="record-a" value="SAVE STATELESS RESULT&#xa;JSON artifact + per-pass evidence&#xa;Success OR failure retained" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="90" y="605" width="350" height="90" as="geometry"/></mxCell>
        <mxCell id="record-b" value="SAVE RETRIEVED RESULT&#xa;JSON artifact + per-pass evidence&#xa;Success OR failure retained" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="610" y="605" width="350" height="90" as="geometry"/></mxCell>
        <mxCell id="compare" value="COMPARE AFTER BOTH CONDITIONS&#xa;Success, passes used, time, tokens, compiler commands&#xa;Unknown cost stays unknown; failures are reported" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="300" y="775" width="510" height="100" as="geometry"/></mxCell>
        <mxCell id="note" value="Executed sequentially: stateless first, then retrieved. Side-by-side layout shows the comparison, not concurrency.&#xa;Example fixed budget: 2 passes; 180 builder seconds/pass; 120 critic seconds/pass. Verification has its own timeout.&#xa;Artifacts generated by condition 1 are NOT automatically passed to condition 2. Preparation for future reuse is on page 3." style="text;whiteSpace=wrap;html=0;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="905" width="1170" height="75" as="geometry"/></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="config" target="stateless" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;exitX=0.2;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="config" target="retrieved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;exitX=0.8;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="memory" target="retrieved" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="stateless" target="loop-a" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="retrieved" target="loop-b" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="loop-a" target="record-a" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="loop-b" target="record-b" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="record-a" target="compare" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;entryX=0.2;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="record-b" target="compare" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;entryX=0.8;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pass-lifecycle" name="2 - Builder and critic loop">
    <mxGraphModel dx="1250" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="ONE CONDITION — BOUNDED REPAIR LOOP" style="text;html=0;fontSize=23;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="230" y="25" width="800" height="45" as="geometry"/></mxCell>
        <mxCell id="builder" value="BUILDER — FRESH CONTAINER EACH PASS&#xa;Original source + own candidate&#xa;Own feedback; frozen memory only if retrieved" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="verify" value="OFFLINE VERIFIER — SEPARATE CONTAINER&#xa;Copy Lean sources; restore protected configuration&#xa;Build + placeholder/custom-axiom scans" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;" vertex="1" parent="1"><mxGeometry x="430" y="310" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="critic" value="CRITIC — SEPARATE FRESH CONTAINER&#xa;Source + private rubric + read-only candidate&#xa;Verification logs; can compile independent checks&#xa;No builder chat, memory, or other condition" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="430" y="480" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="budget" value="Passes&#xa;remaining?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="475" width="210" height="130" as="geometry"/></mxCell>
        <mxCell id="accept" value="ACCEPT FOR THIS RUN&#xa;Formal gate + valid critic pass&#xa;Human semantic sign-off still separate" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="430" y="690" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="exhausted" value="STOP: CAP EXHAUSTED&#xa;Save unresolved proof and all failures" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1"><mxGeometry x="55" y="690" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="human" value="STOP: NEEDS HUMAN&#xa;Critic verdict uncertain&#xa;Do not silently change the assignment" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1"><mxGeometry x="930" y="490" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="infra" value="AT ANY STAGE: INFRASTRUCTURE ERROR&#xa;Service failure, invalid critic report, verifier timeout&#xa;Stop this condition and save diagnostics&#xa;Do not score it as a theorem rejection" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="900" y="140" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="aristotle" value="ARISTOTLE IS DISABLED&#xa;Future only: isolated blocked lemma after&#xa;statement compilation and local decomposition&#xa;Then full local recheck" style="rounded=1;dashed=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1"><mxGeometry x="900" y="690" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="save" value="Every pass is preserved: input hashes, candidate, prompt/transcript, verification, critic report, metrics.&#xa;Repair feedback contains compiler diagnostics and requirement/correction pairs, not the full private critic report.&#xa;Each critic is a new session of the configured model, not a persistent agent living inside a builder container.&#xa;No automatic critic retry or Aristotle call is currently enabled." style="text;whiteSpace=wrap;html=0;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="865" width="1130" height="100" as="geometry"/></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="builder" target="verify" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="formal pass" edge="1" parent="1" source="verify" target="critic" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="formal fail" edge="1" parent="1" source="verify" target="budget" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0;exitY=0.5;entryX=0.5;entryY=0;fontSize=13;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185" y="360"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="reject" edge="1" parent="1" source="critic" target="budget" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="yes: next pass with own candidate + feedback" edge="1" parent="1" source="budget" target="builder" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontSize=13;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="540"/><mxPoint x="20" y="190"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" value="no" edge="1" parent="1" source="budget" target="exhausted" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="valid critic pass" edge="1" parent="1" source="critic" target="accept" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="uncertain" edge="1" parent="1" source="critic" target="human" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="artifact-transfer" name="3 - Artifact reuse boundary">
    <mxGraphModel dx="1000" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="ARTIFACTS CAN CROSS CONTAINERS — THROUGH A CONTROLLED SNAPSHOT" style="text;whiteSpace=wrap;html=0;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="25" width="800" height="70" as="geometry"/></mxCell>
        <mxCell id="raw" value="CURRENT: SAVE STRUCTURED JSON&#xa;Provenance, outcomes, per-pass evidence, candidate lessons&#xa;Time, available tokens, compiler-command counts, source size&#xa;Unknown measurements remain unknown" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="250" y="140" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="curate" value="MANUAL PREPARATION FOR FUTURE REUSE&#xa;Review candidate lessons; retain limitations and evidence&#xa;Remove secrets, completed target proof, and answer leakage&#xa;Generated artifacts start with reuse.approved = false" style="rounded=1;dashed=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="250" y="340" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="freeze" value="FREEZE APPROVED MEMORY BEFORE A NEW PAIR&#xa;Record artifact IDs, file hashes, source runs, and scope&#xa;Fix equal model settings and pass/time budgets in advance&#xa;Do not tune the budget after seeing baseline success/failure" style="rounded=1;dashed=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="250" y="540" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="mount" value="NEW RETRIEVED BUILDER CONTAINER&#xa;Host mounts only the approved snapshot at /memory, read-only&#xa;Paired stateless builder receives no external memory&#xa;Log opened artifact IDs and how they affected decisions" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="250" y="740" width="500" height="120" as="geometry"/></mxCell>
        <mxCell id="note" value="Solid boxes: implemented storage/mounting. Dashed boxes: manual review/preparation, not an automatic agent.&#xa;No direct transfer from condition 1 to condition 2 inside the paired run.&#xa;Same-task reuse is not evidence of generalization; prefer matched distinct tasks for transfer claims.&#xa;Artifacts are external memory, not changes to model weights." style="text;whiteSpace=wrap;html=0;fontSize=15;align=left;" vertex="1" parent="1"><mxGeometry x="100" y="930" width="800" height="115" as="geometry"/></mxCell>
        <mxCell id="e1" value="not auto-promoted" edge="1" parent="1" source="raw" target="curate" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="curate" target="freeze" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="controlled file transfer, not shared conversation" edge="1" parent="1" source="freeze" target="mount" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=13;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
