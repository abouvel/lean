    ∃ perturbed,
      Research.BinaryTreeReduction.IsPerturbation (Research.FloatingPoint.gamma (tree.depth + 1) model.u)
          (Research.BinaryTreeReduction.exactProductTree tree) perturbed ∧
        perturbed.exactSum = Research.BinaryTreeReduction.roundedDotProduct model tree :=
fun model tree hsmall =>
  have htail_small :=
